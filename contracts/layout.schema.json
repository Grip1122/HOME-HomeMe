{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hometwin.local/contracts/layout.schema.json",
  "title": "HomeTwin layout",
  "description": "场景唯一真值。前端据此生成场景与寻路网格，后端据此校验 plan。坐标单位米，y 轴向上，网格只管 x-z。",
  "type": "object",
  "additionalProperties": false,
  "required": ["layout_id", "grid", "rooms", "furniture", "objects"],
  "properties": {
    "layout_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cols", "rows", "cell", "origin"],
      "properties": {
        "cols": { "type": "integer", "minimum": 4, "maximum": 512 },
        "rows": { "type": "integer", "minimum": 4, "maximum": 512 },
        "cell": { "type": "number", "exclusiveMinimum": 0.1, "maximum": 2 },
        "origin": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": { "type": "number" },
          "description": "[x, y, z] 第 (0,0) 格的世界坐标原点"
        }
      }
    },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "rect", "scan_point", "drop_to"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "drop_to": { "type": "string", "description": "用户只说分区（如“放书房”）时的默认落点，必须是该分区内 surface=true 的家具 id" },
          "rect": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "items": { "type": "integer", "minimum": 0 },
            "description": "[col, row, cols, rows] 该分区在网格中占用的矩形"
          },
          "scan_point": {
            "type": "array", "minItems": 3, "maxItems": 3,
            "items": { "type": "number" }
          }
        }
      }
    },
    "doors": {
      "type": "array",
      "description": "分区之间的门洞。跨分区移动只允许经过门洞；宽度须 >= 1.0 米。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "between", "pos", "width", "axis"],
        "properties": {
          "id": { "type": "string" },
          "between": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "items": { "type": "string" }
          },
          "pos": {
            "type": "array", "minItems": 3, "maxItems": 3,
            "items": { "type": "number" },
            "description": "门洞中心的世界坐标"
          },
          "width": { "type": "number", "exclusiveMinimum": 0 },
          "axis": { "type": "string", "enum": ["x", "z"], "description": "门洞宽度沿哪个轴展开" }
        }
      }
    },
    "furniture": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "room", "pos", "size", "blocks", "surface"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "room": { "type": "string" },
          "pos": {
            "type": "array", "minItems": 3, "maxItems": 3,
            "items": { "type": "number" },
            "description": "包围盒底面前-左角的世界坐标"
          },
          "size": {
            "type": "array", "minItems": 3, "maxItems": 3,
            "items": { "type": "number", "exclusiveMinimum": 0 },
            "description": "[宽, 高, 深]"
          },
          "blocks": { "type": "boolean", "description": "为真则占据寻路格子" },
          "surface": { "type": "boolean", "description": "为真则可作为 drop 的落点" },
          "model": { "type": "string", "description": "assets 下的相对路径，缺省用灰盒" }
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "aliases", "room", "pos", "on"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "room": { "type": "string" },
          "pos": {
            "type": "array", "minItems": 3, "maxItems": 3,
            "items": { "type": "number" }
          },
          "on": { "type": "string", "description": "所在家具 id；地面物体写 floor" },
          "model": { "type": "string" },
          "scale": { "type": "number", "exclusiveMinimum": 0, "default": 1 }
        }
      }
    },
    "stains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "room", "pos"],
        "properties": {
          "id": { "type": "string" },
          "room": { "type": "string" },
          "pos": {
            "type": "array", "minItems": 3, "maxItems": 3,
            "items": { "type": "number" }
          }
        }
      }
    }
  }
}
